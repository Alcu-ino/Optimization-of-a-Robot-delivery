# ===========================================================================
# FRONTIERA DI PARETO (pesi-somma): ENERGIA vs TEMPO OPERATIVO
# (pesi w_energia e w_tempo; nel modello w_tempo pesa il tempo operativo)
#
# Script autonomo: ricarica da solo modello e dati, quindi puo' essere
# lanciato da solo, in qualsiasi ordine o in parallelo agli altri
# (sessioni AMPL separate).
#
# Va eseguito con la cartella del progetto come cartella corrente di AMPL,
# dove si trovano Ampl_Main.mod e archi_temp.dat.
#   da terminale:  ampl analisi_pareto_pesi_energia_tempooperativo.run
#   da MATLAB:     ampl.eval(sprintf('cd "%s";', baseDir));
#                  ampl.read(fullfile(baseDir, 'analisi_pareto_pesi_energia_tempooperativo.run'));
#
# Uscita: analisi/out_pareto_pesi_energia_tempooperativo.txt
# Colonna 'stato':
#   0 = ottimo   1 = ammissibile, non dimostrata ottima (limite di tempo)
#   2 = infeasible   3 = nessuna soluzione restituita
# Se non c'e' soluzione (stato 2 o 3) le grandezze sono scritte come NaN.
# ===========================================================================

reset;
model Ampl_Main.mod;
data  archi_temp.dat;

param dir symbolic default "analisi/";   # relativa alla cartella corrente
param N_PASSI integer >= 2 default 5;    # punti della frontiera

option solver cplex;
option cplex_options 'timelimit=600 threads=4 return_mipgap=1 mipdisplay=0';
option solver_msg 0;
suffix relmipgap OUT;

shell ("mkdir -p " & dir);               # Linux / macOS

param fout symbolic;
param ha_sol binary;
param stato integer;
param gap;
param r_costo;  param r_energia; param r_tempo;   param r_ritardo;
param r_cons;   param r_penale;  param r_obj;     param r_socmin;

# ---------------------------------------------------------------------------
# FRONTIERA DI PARETO — METODO PESI-SOMMA: energia vs tempo
# w_energia e w_tempo si dividono 0.4; gli altri pesi restano a 0.2.
# ---------------------------------------------------------------------------
param lam;

let fout := dir & "out_pareto_pesi_energia_tempooperativo.txt";
printf "passo w_energia w_tempo stato solve_result_num gap costo energia tempo_op ritardo consegnati non_consegnati penale obiettivo\n"
    > (fout);

print "";
print "===============================================================";
print "   FRONTIERA DI PARETO (pesi-somma): energia vs tempo";
print "===============================================================";

for {s in 0 .. N_PASSI - 1} {
    let lam := s / (N_PASSI - 1);

    let w_costo   := 0.2;
    let w_energia := 0.2;
    let w_tempo   := 0.2;
    let w_ritardo := 0.2;
    let w_penale  := 0.2;
    let w_energia := 0.4 * (1 - lam);
    let w_tempo := 0.4 * lam;

    let {(i,j) in A} x[i,j] := 0;   # niente valori del solve precedente
    solve;

        let ha_sol := if sum {(i,j) in A: i == nodoPartenza} x[i,j] > 0.5 then 1 else 0;
        let stato  := if solve_result == "solved" and ha_sol == 1 then 0
                      else if ha_sol == 1 then 1
                      else if solve_result == "infeasible" then 2
                      else 3;

    if ha_sol == 1 then {
            let gap       := CostoTotale.relmipgap;
            let r_costo   := sum {(i,j) in A} costo[i,j] * x[i,j];
            let r_energia := sum {(i,j) in A} energia[i,j] * x[i,j];
            let r_tempo   := sum {(i,j) in A: base[i] != "O" or base[j] != "O"}
                                 tempoPercorrenza[i,j] * x[i,j];
            let r_ritardo := sum {c in C} ritardo[c];
            let r_cons    := round(sum {p in P} consegnato[p]);
            let r_penale  := sum {p in P} penale_mancata_consegna[p] * (1 - round(consegnato[p]));
            let r_obj     := CostoTotale;

        printf "%d %.4f %.4f %d %d %.6g %.6g %.6g %.6g %.6g %d %d %.6g %.8g\n",
            s, w_energia, w_tempo, stato, solve_result_num, gap,
            r_costo, r_energia, r_tempo, r_ritardo, r_cons, card(P) - r_cons,
            r_penale, r_obj > (fout);

        printf "  passo %d | w_energia=%.2f w_tempo=%.2f | %-10s | costo %7.1f | energia %6.1f | tempo op. %3d | ritardo %4.1f | consegnati %2d/%d | gap %.3g\n",
            s, w_energia, w_tempo, solve_result,
            r_costo, r_energia, r_tempo, r_ritardo, r_cons, card(P), gap;
    } else {
        printf "%d %.4f %.4f %d %d NaN NaN NaN NaN NaN NaN NaN NaN NaN\n",
            s, w_energia, w_tempo, stato, solve_result_num > (fout);

        printf "  passo %d | w_energia=%.2f w_tempo=%.2f | %-10s | NESSUNA SOLUZIONE\n",
            s, w_energia, w_tempo, solve_result;
    }
}
close (fout);

printf "\n   File generato: %s\n", fout;
