# ===========================================================================
# SENSITIVITA' ALLA CAPACITA' DELLA BATTERIA
#
# Script autonomo: ricarica da solo modello e dati, quindi puo' essere
# lanciato da solo, in qualsiasi ordine o in parallelo agli altri
# (sessioni AMPL separate).
#
# Va eseguito con la cartella del progetto come cartella corrente di AMPL,
# dove si trovano Ampl_Main.mod e archi_temp.dat.
#   da terminale:  ampl analisi_sens_batteria.run
#   da MATLAB:     ampl.eval(sprintf('cd "%s";', baseDir));
#                  ampl.read(fullfile(baseDir, 'analisi_sens_batteria.run'));
#
# Uscita: analisi/out_sens_batteria.txt
# Colonna 'stato':
#   0 = ottimo   1 = ammissibile, non dimostrata ottima (limite di tempo)
#   2 = infeasible   3 = nessuna soluzione restituita
# Se non c'e' soluzione (stato 2 o 3) le grandezze sono scritte come NaN.
# ===========================================================================

reset;
model Ampl_Main.mod;
data  archi_temp.dat;

param dir symbolic default "analisi/";   # relativa alla cartella corrente
# Le energie degli archi sono in % di batteria: 100 e' il riferimento,
# 1260 equivale a una batteria che non limita mai il percorso.
set CAP_SENS ordered default {50,75,100,700,1260};

option solver cplex;
option cplex_options 'timelimit=400 threads=4 return_mipgap=1 mipdisplay=0';
option solver_msg 0;
suffix relmipgap OUT;

shell ("mkdir -p " & dir);               # Linux / macOS

param fout symbolic;
param ha_sol binary;
param stato integer;
param gap;
param r_costo;  param r_energia; param r_tempo;   param r_ritardo;
param r_cons;   param r_penale;  param r_obj;     param r_socmin;

# ---------------------------------------------------------------------------
# SENSITIVITA' ALLA CAPACITA' DELLA BATTERIA (pesi del .dat / default)
# ---------------------------------------------------------------------------
let fout := dir & "out_sens_batteria.txt";
printf "cap_batteria stato solve_result_num gap costo energia tempo_op ritardo consegnati non_consegnati penale obiettivo soc_min\n"
    > (fout);

print "";
print "===============================================================";
print "   SENSITIVITA': CAPACITA' BATTERIA";
print "===============================================================";

for {cap in CAP_SENS} {
    let cap_batteria   := cap;
    let tasso_ricarica := cap;    # ricarica completa in uno slot, come nel main

    let {(i,j) in A} x[i,j] := 0;   # niente valori del solve precedente
    solve;

        let ha_sol := if sum {(i,j) in A: i == nodoPartenza} x[i,j] > 0.5 then 1 else 0;
        let stato  := if solve_result == "solved" and ha_sol == 1 then 0
                      else if ha_sol == 1 then 1
                      else if solve_result == "infeasible" then 2
                      else 3;

    if ha_sol == 1 then {
            let gap       := CostoTotale.relmipgap;
            let r_costo   := sum {(i,j) in A} costo[i,j] * x[i,j];
            let r_energia := sum {(i,j) in A} energia[i,j] * x[i,j];
            let r_tempo   := sum {(i,j) in A: base[i] != "O" or base[j] != "O"}
                                 tempoPercorrenza[i,j] * x[i,j];
            let r_ritardo := sum {c in C} ritardo[c];
            let r_cons    := round(sum {p in P} consegnato[p]);
            let r_penale  := sum {p in P} penale_mancata_consegna[p] * (1 - round(consegnato[p]));
            let r_obj     := CostoTotale;
            let r_socmin  := min {(i,j) in A: x[i,j] > 0.5} soc[j];

        printf "%g %d %d %.6g %.6g %.6g %.6g %.6g %d %d %.6g %.8g %.6g\n",
            cap, stato, solve_result_num, gap, r_costo, r_energia, r_tempo,
            r_ritardo, r_cons, card(P) - r_cons, r_penale, r_obj, r_socmin > (fout);

        printf "  cap %6g | %-10s | obiettivo %.5f | energia %6.1f | consegnati %2d/%d | SOC min %.1f | gap %.3g\n",
            cap, solve_result, r_obj, r_energia, r_cons, card(P), r_socmin, gap;
    } else {
        printf "%g %d %d NaN NaN NaN NaN NaN NaN NaN NaN NaN NaN\n",
            cap, stato, solve_result_num > (fout);

        printf "  cap %6g | %-10s | NESSUNA SOLUZIONE\n", cap, solve_result;
    }
}
close (fout);

printf "\n   File generato: %s\n", fout;
