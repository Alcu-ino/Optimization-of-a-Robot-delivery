# ===========================================================================
# SCALABILITA' 4 - ORARIO DI APERTURA DEI CLIENTI (finestra rigida)
#
# Clienti: i primi N_META = floor(n/2) dell'ordine casuale, 1 pacco ciascuno,
# finestra di consegna di base. Il primo passo (apertura comune APERTURA_COMUNE)
# e' la soluzione gia' nota dell'esperimento clienti (RIGA_NOTA) e viene solo
# copiato; poi l'orario di apertura, uguale per tutti i clienti, si allarga di
# 1 h a ogni passo (prima la chiusura, poi l'apertura quando la chiusura arriva
# a fine giornata).
#
# A differenza della finestra di consegna, l'orario di apertura cambia la rete
# spazio-tempo (nodi e archi): a ogni passo si sostituiscono i dati della rete
# con il file preparato da lancia_scalabilita.m (aperture/rete_<k>.dat).
# Il modello Ampl_Main.mod non viene modificato.
#
# Arresto: gap a fine solve (600 s) >= GAP_STOP, nessuna soluzione, oppure
# apertura arrivata a tutta la giornata.
#
# Lanciato da lancia_scalabilita.m dopo l'esperimento clienti.
# Ingresso: scal_base.dat, scal_param.dat, scal_meta.dat, scal_aperture.dat,
#           aperture/rete_<k>.dat
# Uscita  : analisi/scalabilita/out_scal_apertura.txt
#           analisi/scalabilita/scenari/apertura_clienti.dat
# ===========================================================================

reset;
model Ampl_Main.mod;                          # modello di riferimento, NON modificato
data  analisi/scalabilita/scal_base.dat;      # rete con APERTURA_COMUNE, robot, batteria

# ---------------------------------------------------------------------------
# PARAMETRI DELLO STUDIO (scritti da lancia_scalabilita.m in scal_param.dat)
# ---------------------------------------------------------------------------
param NCAND integer > 0;            # clienti candidati
param ORDINE {1..NCAND} symbolic;   # ordine casuale di aggiunta dei clienti
param TW_INIZIO;                    # inizio della finestra comune (slot)
param TW_ORE_BASE;                  # larghezza della finestra di base (ore)
param SLOT_ORA;                     # slot in un'ora
param GAP_STOP;                     # arresto: gap relativo a fine solve >= GAP_STOP
param PENALE_PACCO;                 # penale di mancata consegna (come in main.m)
param PPC_MAX integer;              # (non usato qui)
param DIR_SCEN symbolic;            # cartella dei dati dei singoli passi
data analisi/scalabilita/scal_param.dat;

# --- soluzione gia' nota: floor(n/2) clienti (scal_meta.dat) ----------------
param N_META integer > 0;
param RIGA_NOTA symbolic;           # riga gia' risolta (colonne comuni, origine = 1)
data analisi/scalabilita/scal_meta.dat;

# --- passi dell'apertura (scal_aperture.dat) --------------------------------
param NAP integer > 0;              # numero di passi
param AP_INIZIO_BASE;               # apertura comune della soluzione nota (slot)
param AP_FINE_BASE;                 # chiusura comune della soluzione nota (slot)
param AP_INIZIO {1..NAP};           # apertura dei clienti al passo k (slot)
param AP_FINE   {1..NAP};           # chiusura dei clienti al passo k (slot)
param AP_FILE   {1..NAP} symbolic;  # file della rete al passo k
data analisi/scalabilita/scal_aperture.dat;

option solver cplex;
option cplex_options 'timelimit=600 mipgap=0.01 threads=4 return_mipgap=1 mipdisplay=0';
option solver_msg 0;
suffix relmipgap OUT;

# ---------------------------------------------------------------------------
# SCENARIO E RISULTATI
# ---------------------------------------------------------------------------
set   CS ordered;          # clienti dello scenario
param PPC integer;         # pacchi per cliente
param ORE;                 # larghezza della finestra di consegna (ore)
param fdat symbolic;       # file dati dello scenario
param fout symbolic;       # file dei risultati
param ha_sol binary;  param stato integer;  param fermo binary;
param r_gap;  param r_sec;  param r_cons;  param r_rit;  param r_obj;  param r_soc;

let fout := "analisi/scalabilita/out_scal_apertura.txt";
printf "n_clienti pacchi_per_cliente n_pacchi tw_inizio tw_fine tw_ore stato solve_result_num gap secondi nvars ncons consegnati non_consegnati ritardo obiettivo soc_min origine ap_inizio ap_fine ap_ore\n" > (fout);

print "";
print "===============================================================";
print "   SCALABILITA': ORARIO DI APERTURA";
print "===============================================================";

# ---------------------------------------------------------------------------
# DATI DEI CLIENTI: uguali in tutti i passi (floor(n/2) clienti, 1 pacco,
# finestra di base). Si scrivono e caricano una sola volta.
# ---------------------------------------------------------------------------
let CS   := setof {i in 1..N_META} ORDINE[i];
let PPC  := 1;
let ORE  := TW_ORE_BASE;
let fdat := DIR_SCEN & "apertura_clienti.dat";

printf "# %d clienti, %d pacchi per cliente, finestra %g h\n", card(CS), PPC, ORE > (fdat);
printf "set C :=" > (fdat);
printf {c in CS} " %s", c > (fdat);
printf ";\n\nset P :=" > (fdat);
printf {c in CS, j in 1..PPC} " %sp%d", c, j > (fdat);
printf ";\n\nparam pacco_cliente :=\n" > (fdat);
printf {c in CS, j in 1..PPC} "  %sp%d %s\n", c, j, c > (fdat);
printf ";\n\nparam peso_pacco :=\n" > (fdat);
printf {c in CS, j in 1..PPC} "  %sp%d %g\n", c, j, cap_max_robot > (fdat);
printf ";\n\nparam penale_mancata_consegna :=\n" > (fdat);
printf {c in CS, j in 1..PPC} "  %sp%d %g\n", c, j, PENALE_PACCO > (fdat);
printf ";\n\nparam startline :=\n" > (fdat);
printf {c in CS} "  %s %d\n", c, TW_INIZIO > (fdat);
printf ";\n\nparam deadline :=\n" > (fdat);
printf {c in CS} "  %s %d\n", c, TW_INIZIO + ORE * SLOT_ORA > (fdat);
printf ";\n" > (fdat);
close (fdat);
data (fdat);

# --- primo passo: apertura comune di base, soluzione gia' nota ---------------
printf "%s %d %d %g\n", RIGA_NOTA, AP_INIZIO_BASE, AP_FINE_BASE,
    (AP_FINE_BASE - AP_INIZIO_BASE) / SLOT_ORA > (fout);
printf "  %2d clienti x 1 pacchi | apertura di base | soluzione riusata dall'esperimento clienti\n", N_META;

for {k in 1..NAP} {

    # --- A. RETE DEL PASSO: si sostituiscono solo nodi, archi e loro dati ------
    reset data V, A, costo, energia, tempoPercorrenza, tempoNodo,
               nome_nodo_partenza, nome_nodo_arrivo;
    data (AP_FILE[k]);

    # --- B. RISOLUZIONE ----------------------------------------------------------
    let {(i,j) in A} x[i,j] := 0;     # nessun valore del passo precedente
    solve;

    let r_sec  := _solve_elapsed_time;
    let ha_sol := if sum {(i,j) in A: i == nodoPartenza} x[i,j] > 0.5 then 1 else 0;
    let stato  := if solve_result == "solved" and ha_sol == 1 then 0     # ottimo (entro mipgap)
                  else if ha_sol == 1 then 1                              # limite di tempo
                  else if solve_result == "infeasible" then 2
                  else 3;                                                 # nessuna soluzione

    # --- C. REGISTRAZIONE (origine = 0: risolto in questo script) ---------------
    if ha_sol == 1 then {
        let r_gap  := CostoTotale.relmipgap;
        let r_cons := round(sum {p in P} consegnato[p]);
        let r_rit  := sum {c in C} ritardo[c];
        let r_obj  := CostoTotale;
        let r_soc  := min {(i,j) in A: x[i,j] > 0.5} soc[j];
        let fermo  := if r_gap >= GAP_STOP then 1 else 0;

        printf "%d %d %d %d %d %g %d %d %.6g %.2f %d %d %d %d %.6g %.8g %.6g %d %d %d %g\n",
            card(C), PPC, card(P), TW_INIZIO, TW_INIZIO + ORE * SLOT_ORA, ORE,
            stato, solve_result_num, r_gap, r_sec, _nvars, _ncons,
            r_cons, card(P) - r_cons, r_rit, r_obj, r_soc, 0,
            AP_INIZIO[k], AP_FINE[k], (AP_FINE[k] - AP_INIZIO[k]) / SLOT_ORA > (fout);
        printf "  apertura [%2d %2d] = %5.2f h | %d archi | %-8s | %6.1f s | gap %.4f | consegnati %d/%d\n",
            AP_INIZIO[k], AP_FINE[k], (AP_FINE[k] - AP_INIZIO[k]) / SLOT_ORA, card(A),
            solve_result, r_sec, r_gap, r_cons, card(P);
    } else {
        let fermo := 1;
        printf "%d %d %d %d %d %g %d %d NaN %.2f %d %d NaN NaN NaN NaN NaN %d %d %d %g\n",
            card(C), PPC, card(P), TW_INIZIO, TW_INIZIO + ORE * SLOT_ORA, ORE,
            stato, solve_result_num, r_sec, _nvars, _ncons, 0,
            AP_INIZIO[k], AP_FINE[k], (AP_FINE[k] - AP_INIZIO[k]) / SLOT_ORA > (fout);
        printf "  apertura [%2d %2d] = %5.2f h | %d archi | %-8s | %6.1f s | NESSUNA SOLUZIONE\n",
            AP_INIZIO[k], AP_FINE[k], (AP_FINE[k] - AP_INIZIO[k]) / SLOT_ORA, card(A),
            solve_result, r_sec;
    }

    # --- D. CRITERIO DI ARRESTO -------------------------------------------------
    if fermo == 1 then {
        print "   ARRESTO: gap a fine solve >= GAP_STOP o nessuna soluzione";
        break;
    }
}
close (fout);
printf "\n   File generato: %s\n", fout;
